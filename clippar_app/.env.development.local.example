# Dev environment for the "Clippar Dev" build (com.clippar.app.dev).
# Copy to .env.development.local and fill in with your DEV Supabase project's keys.
# Loaded by `expo start` when APP_VARIANT=development is set, e.g.:
#   APP_VARIANT=development npx expo start
#
# For EAS Build, these values come from EAS env vars in the "development"
# environment (see eas.json `build.development.environment: "development"`).
# Manage them at:
#   https://expo.dev/accounts/clippar/projects/clippar/environment-variables
# This file is only used for local dev runs.

# Supabase (DEV project — create a separate Supabase project for testing)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY

# Stripe (test keys — same as prod test keys are fine if you only have one Stripe account)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Pipeline (point at a dev deploy or reuse prod — your choice)
EXPO_PUBLIC_PIPELINE_URL=https://clippar-pipeline-dev.onrender.com
EXPO_PUBLIC_PIPELINE_API_KEY=YOUR_DEV_PIPELINE_API_KEY

# Concat
EXPO_PUBLIC_CONCAT_URL=https://clippar-concat-dev.onrender.com

# Golf Course API (same key works in both envs)
# MOVED SERVER-SIDE. The course-search key is no longer read by the app — it is
# the GOLF_COURSE_API_KEY secret on the Supabase project, used by the
# search-courses edge function. A live key sat here in plaintext in a PUBLIC
# repo, which is why it must be rotated, not just relocated.
# EXPO_PUBLIC_GOLF_COURSE_API_KEY=

# RevenueCat (Clippar Pro IAP). PUBLIC iOS SDK key from the RevenueCat
# dashboard → Project → API keys (starts with `appl_`). Safe to ship in the
# client. Empty/absent → lib/iap falls back to the stub (Expo Go / no native
# module), paywall still renders. See clippar_app/IAP_SETUP.md.
EXPO_PUBLIC_RC_IOS_KEY=appl_YOUR_DEV_REVENUECAT_PUBLIC_KEY
