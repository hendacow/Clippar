# Files NOT to upload to EAS Build.
# EAS regenerates these on the build server, so uploading them is wasted bytes.
# Drops project archive from ~186 MB to ~30 MB (typical) → faster builds.
# See: https://expo.fyi/eas-build-archive

# IMPORTANT: ignore the entire ios/ and android/ folders so EAS runs a clean
# `expo prebuild` from app.config.js each build. Uploading a stale local
# ios/ folder caused a real outage — the local Expo.plist had
# EXUpdatesEnabled=false (generated before `updates.url` was added to
# app.config.js) and EAS used that as-is, silently disabling all OTAs for
# every build. Don't upload native folders — let EAS prebuild them.
ios/
android/

# Documentation (not needed at build time)
*.md
!README.md

# Test files (not needed at build time)
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
__tests__/

# IDE
.vscode/
.idea/
*.swp

# Local env files — EAS uses repo secrets / env vars, not these
.env*.local
.env*.local.example

# OS junk
.DS_Store
Thumbs.db

# Already not tracked but be defensive
node_modules/
