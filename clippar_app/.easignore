# Files NOT to upload to EAS Build.
# EAS regenerates these on the build server, so uploading them is wasted bytes.
# Drops project archive from ~186 MB to ~30 MB (typical) → faster builds.
# See: https://expo.fyi/eas-build-archive

# IMPORTANT: ignore the ROOT ios/ and android/ folders so EAS runs a clean
# `expo prebuild` from app.config.js each build. Uploading a stale local
# ios/ folder caused a real outage — the local Expo.plist had
# EXUpdatesEnabled=false (generated before `updates.url` was added to
# app.config.js) and EAS used that as-is, silently disabling all OTAs for
# every build. Don't upload generated root native folders — let EAS prebuild them.
#
# IMPORTANT: leading slash anchors these to the project root so they only
# match clippar_app/ios/ and clippar_app/android/. Without the slash, the
# pattern would match nested directories like modules/shot-detector/ios/
# which contains the custom Swift implementation of ShotDetectorModule.
/ios/
/android/

# Documentation (not needed at build time)
*.md
!README.md

# Test files (not needed at build time)
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
__tests__/

# IDE
.vscode/
.idea/
*.swp

# Local env files — EAS uses repo secrets / env vars, not these
.env*.local
.env*.local.example

# OS junk
.DS_Store
Thumbs.db

# Already not tracked but be defensive
node_modules/

# Agent + tooling state. These are gitignored, but .easignore REPLACES .gitignore
# for EAS uploads — anything not listed here is uploaded even if git ignores it.
# `.claude/worktrees` alone measured 2.5 GB on 30 Aug 2026 and is what produced a
# 428 MB project archive (against the ~30 MB this file claims above) and an upload
# that hung long enough to be abandoned mid-session.
.claude/
.playwright-mcp/
.history/

# Build output and non-runtime asset folders — regenerated or never needed on the
# build server. Measured 30 Aug: dist 69 MB, golfcam 38 MB, store-assets 21 MB.
# NOTE: do NOT add modules/ — that is the native Swift shot-detector source.
dist/
golfcam/
store-assets/
