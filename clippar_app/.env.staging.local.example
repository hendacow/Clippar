# Staging environment for the "Clippar Staging" build (com.clippar.app.staging).
# Copy to .env.staging.local and fill in with your STAGING Supabase project's keys.
# Loaded by `expo start` when APP_VARIANT=staging is set, e.g.:
#   APP_VARIANT=staging npx expo start
#
# For EAS Build, these values come from EAS env vars in the "preview" environment
# (see eas.json `build.staging.environment: "preview"`). Manage them at:
#   https://expo.dev/accounts/clippar/projects/clippar/environment-variables

# Supabase (STAGING project — separate from dev and prod)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY

# Stripe (TEST keys — never put live keys in staging)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Pipeline (point at a staging deploy of the Python pipeline)
EXPO_PUBLIC_PIPELINE_URL=https://clippar-pipeline-staging.onrender.com
EXPO_PUBLIC_PIPELINE_API_KEY=YOUR_STAGING_PIPELINE_API_KEY

# Concat service
EXPO_PUBLIC_CONCAT_URL=https://clippar-concat-staging.onrender.com

# Golf Course API (same key works in all envs)
# MOVED SERVER-SIDE. The course-search key is no longer read by the app — it is
# the GOLF_COURSE_API_KEY secret on the Supabase project, used by the
# search-courses edge function. A live key sat here in plaintext in a PUBLIC
# repo, which is why it must be rotated, not just relocated.
# EXPO_PUBLIC_GOLF_COURSE_API_KEY=

# RevenueCat (Clippar Pro IAP). PUBLIC iOS SDK key (`appl_`) from the
# RevenueCat dashboard → Project → API keys. Safe to ship in the client.
# Empty/absent → lib/iap stub fallback. See clippar_app/IAP_SETUP.md.
EXPO_PUBLIC_RC_IOS_KEY=appl_YOUR_REVENUECAT_PUBLIC_KEY
