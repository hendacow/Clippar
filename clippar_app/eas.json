{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "production",
      "prebuildCommand": "expo prebuild --clean --no-install",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "prebuildCommand": "expo prebuild --clean --no-install",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "prebuildCommand": "expo prebuild --clean --no-install",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    },
    "devstandalone": {
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "env": {
        "APP_VARIANT": "development",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "appstandalone": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "production",
      "prebuildCommand": "expo prebuild --clean --no-install",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "appleId": "henrycoward@icloud.com",
        "ascAppId": "PLACEHOLDER_STAGING_ASC_APP_ID",
        "appleTeamId": "LBJUXXPJ6H"
      }
    },
    "production": {
      "ios": {
        "appleId": "henrycoward@icloud.com",
        "ascAppId": "6788301452",
        "appleTeamId": "LBJUXXPJ6H"
      }
    }
  }
}