{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging"
      }
    },
    "internal": {
      "distribution": "internal",
      "channel": "production",
      "environment": "production",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "ios": { "buildConfiguration": "Release" },
      "android": { "buildType": "app-bundle" },
      "autoIncrement": true
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "appleId": "henrycoward@icloud.com",
        "ascAppId": "PLACEHOLDER_STAGING_ASC_APP_ID",
        "appleTeamId": "LBJUXXPJ6H"
      }
    },
    "production": {
      "ios": {
        "appleId": "henrycoward@icloud.com",
        "ascAppId": "PLACEHOLDER_PRODUCTION_ASC_APP_ID",
        "appleTeamId": "LBJUXXPJ6H"
      }
    }
  }
}
