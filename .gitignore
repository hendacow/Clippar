.DS_Store
__pycache__/
*.pyc

.venv/
.env
# Match the CLASS, not one name. `.env` on its own is a basename match and
# covers nothing else — which is why `clippar_app/.env.local` needed its own
# line, and why `clippar_app/.env.production` (which the committed .example
# files show carries SUPABASE_SERVICE_ROLE_KEY and STRIPE_SECRET_KEY) was
# ignored by nothing at all.
#
# The scan only DETECTS, and only after a push has already made the blob
# world-readable on a public repo. These rules are the half that PREVENTS, so
# they have to cover every shape the scan fails on.
.env.*
!.env.example
!.env.*.example
service_account.json
oauth_credentials.json
drive_token.json
clippar.db
jobs/

inputs/
inputs copy/
inputs random/
outputs/
outputs random/
tmp_validation_force/
tmp_validation_run/
validation_runs/
.history/
.agents/
.claude/
alex_inputs/
alex_outputs/

# Logs
clippar.log
clippar_error.log

# Generated logos (keep in repo if you want, remove this line)
# clippar_logo_*.png

# Clippar App
clippar_app/node_modules/
clippar_app/.env.local
clippar_app/.expo/
clippar_app/dist/
clippar_app/ios/
clippar_app/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
tmp_flip_run/

# SQLite WAL files
clippar.db-shm
clippar.db-wal

# Local / binary artefacts that should not be committed.
#
# Match by extension only — never add a specific filename here: this file is
# world-readable and its history stays readable after an edit, so a named entry
# is a public index.
#
# Keep this list in sync with BINDOC in scripts/secret-scan.sh. Anything the
# scan FAILs on should never have been stageable in the first place — the scan
# only detects after a push, and on a public repo a pushed blob is already out.
*.doc
*.docx
*.docm
*.xls
*.xlsx
*.xlsm
*.ppt
*.pptx
*.odt
*.ods
*.odp
*.rtf
*.pdf
*.numbers
*.pages
*.vsix
# Archives — a compressed container hides its contents from every text scan
*.zip
*.7z
*.rar
*.jar
*.war
*.tgz
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
*.gz
*.bz2
*.xz
*.zst
# Binary credential containers — the higher-value half
*.p12
*.pfx
*.jks
*.keystore
*.bcfks
*.kdbx
*.mobileprovision
*.cer
*.der
# Mobile bundles — they carry signing and provisioning material
*.apk
*.aab
*.ipa
# Local databases
*.db
*.sqlite
*.sqlite3
# Office lock/owner files
~$*
