.DS_Store
__pycache__/
*.pyc

.venv/
.env
# Match the CLASS, not one name. `.env` on its own is a basename match and
# covers nothing else — which is why `clippar_app/.env.local` used to need its
# own hand-written line further down, and why `clippar_app/.env.production`
# (which the committed .example files show carries SUPABASE_SERVICE_ROLE_KEY and
# STRIPE_SECRET_KEY) was ignored by nothing at all. That hand-written line is
# now gone: the pattern covers it, and a named entry in a world-readable file is
# a public index, which is the rule this file sets for itself below.
#
# The scan only DETECTS, and only after a push has already made the blob
# world-readable on a public repo. These rules are the half that PREVENTS, so
# they have to cover every shape the scan fails on.
.env.*
!.env.example
!.env.*.example
service_account.json
oauth_credentials.json
drive_token.json
clippar.db
jobs/

inputs/
inputs copy/
inputs random/
outputs/
outputs random/
tmp_validation_force/
tmp_validation_run/
validation_runs/
.history/
.agents/
.claude/
alex_inputs/
alex_outputs/

# Logs
clippar.log
clippar_error.log

# Generated logos (keep in repo if you want, remove this line)
# clippar_logo_*.png

# Clippar App
clippar_app/node_modules/
clippar_app/.expo/
clippar_app/dist/
clippar_app/ios/
clippar_app/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
tmp_flip_run/

# SQLite WAL files
clippar.db-shm
clippar.db-wal

# Local / binary artefacts that should not be committed.
#
# Match by extension only — never add a specific filename here: this file is
# world-readable and its history stays readable after an edit, so a named entry
# is a public index.
#
# Keep this list in sync with BINDOC in scripts/secret-scan.sh. Anything the
# scan FAILs on should never have been stageable in the first place — the scan
# only detects after a push, and on a public repo a pushed blob is already out.
*.doc
*.docx
*.docm
*.xls
*.xlsx
*.xlsm
*.ppt
*.pptx
*.odt
*.ods
*.odp
*.rtf
*.pdf
*.numbers
*.pages
*.vsix
# Archives — a compressed container hides its contents from every text scan
*.zip
*.7z
*.rar
*.jar
*.war
*.tgz
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
*.gz
*.bz2
*.xz
*.zst
# Binary credential containers — the higher-value half
*.p12
*.pfx
*.jks
*.keystore
*.bcfks
*.kdbx
*.mobileprovision
*.cer
*.der
# Mobile bundles — they carry signing and provisioning material
*.apk
*.aab
*.ipa
# Local databases
*.db
*.sqlite
*.sqlite3
# Office lock/owner files
~$*

# Not part of the app, and not ours to ship. These sit untracked in this
# checkout and were being swept into every EAS upload, because .easignore /
# .gitignore is what bounds the project archive: the 6 Sep dev build produced a
# 533 MB archive and died mid-upload on it.
#   clippar_mount/    the kit-mount CAD project — its own git repo, 679 MB .venv
#   migration/        waitlist CSVs. CUSTOMER EMAIL ADDRESSES. These must never
#                     leave this machine in a build archive.
#   logo_transparent/ brand art, used by nothing at build time
#   .vercel/          local Vercel link state
clippar_mount/
migration/
logo_transparent/
.vercel/
