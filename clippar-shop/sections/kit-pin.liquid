{%- comment -%}
  What's in the kit — the mirror of the app's pinned scroll directly above it.

  Same engine as feature-pin.liquid (view-timeline scroll pinning, stop-motion
  swap, the device rotating through positions) with every class renamed
  kitpin-* so the two sections' stylesheets never collide on the same page.

  Deliberately mirrored: the app section runs device-left, text-right; this
  one runs text-left, device-right, so scrolling from one into the other reads
  as a matched pair rather than a repeat of the same layout.

  25 Aug 2026: every item now carries a real image, from the component photos
  Henry sourced. Processed rather than used raw — retailer UI cropped away,
  backgrounds keyed to black, and the clicker's button faces repainted plain
  because the source part was printed with another company's brand name, which
  the actual white-label Clippar clicker will not carry.

  The mount is the one genuine in-use photograph (a phone mount clamped to a
  real bag) and is the strongest asset here. Note it shows a flexible-tripod
  mount, which matches Henry's workbook ("flexible tripod, spring clamp"), NOT
  the screw-clamp design in clippar_mount/. Those are two different mounts and
  only one can be the product — flagged for Henry.

  A block with no `asset_name` still falls back to a numbered placeholder, so
  adding a sixth item never renders a broken image.
{%- endcomment -%}

{%- assign count = section.blocks.size -%}
{%- if count == 0 -%}{%- break -%}{%- endif -%}
{%- assign slice = 100 | divided_by: count -%}

<section
  class="kitpin full-width{% if section.settings.tone == 'dark' %} kitpin--dark{% endif %}"
  style="--kitpin-scenes: {{ count }};"
>
  <div class="kitpin-intro">
    {%- if section.settings.label != blank -%}
      <p class="kitpin-label">{{ section.settings.label }}</p>
    {%- endif -%}
    <h2 class="kitpin-title">{{ section.settings.title }}</h2>
    {%- if section.settings.intro != blank -%}
      <div class="kitpin-copy">{{ section.settings.intro }}</div>
    {%- endif -%}
  </div>

  <div class="kitpin-track">
    <div class="kitpin-stage kitpin-stage--mirror">
      {%- comment -%}
        Text first in the DOM, device second — mirrors feature-pin.liquid,
        where the device comes first. Grid auto-placement then puts this
        column on the left and the device on the right.
      {%- endcomment -%}
      <div class="kitpin-callouts">
        {%- for block in section.blocks -%}
          {%- assign from = forloop.index0 | times: slice -%}
          {%- assign to = forloop.index | times: slice -%}
          <figure
            class="kitpin-callout kitpin-callout--{{ forloop.index }}"
            style="--from: {{ from }}%; --to: {{ to }}%;"
          >
            <span class="kitpin-arrow" aria-hidden="true"></span>
            <figcaption>
              <span class="kitpin-step">{{ forloop.index | prepend: '0' | slice: -2, 2 }} / {{ count | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="kitpin-feature">{{ block.settings.feature }}</h3>
              <span class="kitpin-caption">{{ block.settings.caption }}</span>
              {%- capture nl %}
{% endcapture -%}
              {%- assign points = block.settings.points | split: nl -%}
              {%- if points.size > 0 -%}
                <ul class="kitpin-points">
                  {%- for point in points -%}
                    {%- assign line = point | strip_newlines | strip -%}
                    {%- if line != blank -%}
                      <li>{{ line }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>

      <div class="kitpin-device">
        <div class="kitpin-frame">
          <div class="kitpin-screen">
            {%- for block in section.blocks -%}
              {%- assign from = forloop.index0 | times: slice -%}
              {%- assign to = forloop.index | times: slice -%}
              {%- if block.settings.asset_name != blank -%}
                <img
                  class="kitpin-shot kitpin-shot--{{ forloop.index }}"
                  style="--from: {{ from }}%; --to: {{ to }}%;"
                  {%- comment -%}
                    Descriptors below are MEASURED from the files Shopify
                    actually returns, not inferred from the size requested.
                    `asset_img_url` does not resize predictably across aspect
                    ratios — for these 1000x1250 tiles '640x' comes back 640
                    wide, while on a taller source the same filter has come
                    back height-constrained instead. A descriptor that lies
                    makes the browser pick the wrong file, so it gets checked
                    rather than assumed. Source is 1000px wide, so that is the
                    ceiling — there is no point offering a larger candidate.
                  {%- endcomment -%}
                  src="{{ block.settings.asset_name | asset_url }}"
                  srcset="
                    {{ block.settings.asset_name | asset_img_url: '640x' }} 640w,
                    {{ block.settings.asset_name | asset_url }} 1000w
                  "
                  alt="{{ block.settings.alt | default: block.settings.feature | escape }}"
                  decoding="async"
                  sizes="(min-width: 900px) 17rem, 65vw"
                  {{ block.shopify_attributes }}
                >
              {%- else -%}
                <div
                  class="kitpin-shot kitpin-shot--{{ forloop.index }} kitpin-shot-placeholder"
                  style="--from: {{ from }}%; --to: {{ to }}%;"
                  {{ block.shopify_attributes }}
                >
                  <span>{{ forloop.index }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .kitpin {
    display: grid;
    grid-template-columns: var(--content-grid);
    background: var(--bg);
    padding-block: clamp(64px, 9vw, 104px) 0;
    overflow: clip;
  }

  .kitpin--dark { background: var(--bg2); }

  .kitpin-intro { grid-column: 2; max-width: 46rem; }
  .kitpin-track { grid-column: 2; }

  .kitpin-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green);
    margin: 0 0 0.75rem;
  }

  .kitpin-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: var(--white);
    margin: 0;
  }

  /* One word in the accent colour so the heading has a focal point rather than
     being a uniform slab of caps. */
  .kitpin-title em { font-style: normal; color: var(--green); }

  .kitpin-copy { color: var(--muted); line-height: 1.7; margin-block-start: 1rem; }
  .kitpin-copy p { margin: 0; }

  /* --- fallback layout: a readable stack ------------------------------------
     This is what renders without scroll-driven animation support, and it has to
     be complete on its own. Everything below is progressive enhancement. */
  .kitpin-stage { display: grid; gap: clamp(2rem, 6vw, 3.5rem); padding-block: clamp(2.5rem, 6vw, 4rem); }
  .kitpin-device { display: grid; place-items: center; }

  /* Product tile, not a phone. Solid black stage rather than the app
     section's device bezel — every item here is a physical object, not a
     screen, and Henry asked for these on a pure black background. */
  .kitpin-frame {
    position: relative;
    width: min(64vw, 16rem);
    border-radius: 1.25rem;
    padding: 1.5rem;
    background: #000;
    box-shadow:
      0 1px 0 rgba(255,255,255,0.06) inset,
      0 40px 80px -28px rgba(0,0,0,0.9);
  }

  .kitpin-screen {
    position: relative;
    border-radius: 0.7rem;
    overflow: hidden;
    background: #000;
    aspect-ratio: 4 / 5;
  }

  .kitpin-shot {
    width: 100%;
    height: 100%;
    /* `contain`, not `cover` — a placeholder mount render or a future product
       shot should never be cropped to fill the tile. */
    object-fit: contain;
    position: relative;
    z-index: 1;
    display: block;
  }

  .kitpin-shot-placeholder {
    display: grid;
    place-items: center;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 3rem;
    letter-spacing: 0.05em;
    border: 1px dashed var(--border);
  }

  .kitpin-callouts { display: grid; gap: 1.5rem; }

  .kitpin-callout { margin: 0; display: flex; gap: 0.85rem; align-items: flex-start; }

  .kitpin-callout figcaption { display: grid; gap: 0.3rem; }

  .kitpin-step {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--green);
  }

  /* The feature name is the headline of its scene, so it is set like one.
     Display face, big, tight — it has to hold its own next to a phone. */
  .kitpin-feature {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--white);
    margin: 0.1rem 0 0.4rem;
  }

  .kitpin-caption {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
    color: var(--white);
    max-width: 24rem;
  }

  /* The sub-features for this section of the app. Ticked rather than bulleted —
     a bullet reads as prose, a tick reads as a capability. */
  .kitpin-points {
    list-style: none;
    margin: 0.55rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    max-width: 24rem;
  }

  .kitpin-points li {
    position: relative;
    padding-inline-start: 1.05rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .kitpin-points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.42em;
    width: 0.4rem;
    height: 0.22rem;
    border-left: 1.5px solid var(--green);
    border-bottom: 1.5px solid var(--green);
    transform: rotate(-45deg);
  }

  /* The arrow: a rule with a rotated head. Hidden in the stacked fallback,
     where there is nothing to point at. */
  .kitpin-arrow { display: none; }

  /* --- enhanced: pinned, rotating, one scene at a time --------------------- */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .kitpin-track {
        /* One viewport of scroll per scene, plus one to read the last. */
        height: calc(100svh * (var(--kitpin-scenes) + 1));
        view-timeline-name: --kitpin;
        view-timeline-axis: block;
      }

      .kitpin-stage {
        position: sticky;
        top: var(--nav-h, 83px);
        height: calc(100svh - var(--nav-h, 83px));
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: clamp(2rem, 6vw, 5rem);
        padding-block: 0;
      }

      /* Shared perspective so the device reads as an object in a room. */
      .kitpin-device { perspective: 1400px; perspective-origin: 50% 45%; }

      /* The mirror: this section's device sits on the right, so the callout
         column and the arrow both flip. The grid itself needs no reordering —
         the markup is already written text-first, device-second, which is
         the opposite DOM order to feature-pin.liquid. */
      .kitpin-stage--mirror .kitpin-callout { flex-direction: row-reverse; }
      .kitpin-stage--mirror .kitpin-arrow { transform: scaleX(-1); }

      .kitpin-frame {
        width: min(30vw, 17rem);
        animation: kitpin-turn linear both;
        animation-timeline: --kitpin;
        animation-range: contain 0% contain 100%;
        transform-style: preserve-3d;
      }

      /* The device travels through positions rather than simply spinning —
         yaw, a little pitch, and a drift across the stage, so each scene is
         framed slightly differently. */
      @keyframes kitpin-turn {
        0%   { transform: rotateY(28deg)  rotateX(6deg)  translate3d(6%, 4%, 0)  scale(0.94); }
        35%  { transform: rotateY(-6deg)  rotateX(-2deg) translate3d(-2%, -2%, 0) scale(1); }
        70%  { transform: rotateY(-22deg) rotateX(4deg)  translate3d(3%, 2%, 0)  scale(0.97); }
        100% { transform: rotateY(4deg)   rotateX(-5deg) translate3d(-4%, -3%, 0) scale(1.02); }
      }

      /* Screens cross-fade within their own slice of the track. Each carries
         its own --from/--to, written by Liquid, so the slices always divide the
         timeline evenly however many blocks exist. */
      .kitpin-shot {
        position: absolute;
        inset: 0;
        opacity: 0;
        animation: kitpin-swap linear both;
        animation-timeline: --kitpin;
        animation-range: contain var(--from) contain var(--to);
      }

      /* The first screen is visible WITHOUT the animation having run.
         A scroll timeline can fail to resolve — a browser that supports the
         syntax but cannot attach the timeline leaves every animation inactive,
         and with a base of `opacity: 0` that renders an empty phone with no
         sign anything is wrong. Observed exactly that. When the timeline does
         resolve the animation overrides this, so it costs nothing. */
      .kitpin-shot--1 { opacity: 1; }

      /* Stop-motion, not cross-fade.
         `steps(1, end)` on the opacity means a screen is either on or off —
         it snaps to the next one the way a stop-motion frame changes, rather
         than the two ghosting through each other. Two screenshots dissolving
         into one another is mush; a cut is legible.
         The scale still eases, so the phone keeps moving through the cut. */
      @keyframes kitpin-swap {
        0%   { opacity: 0; }
        6%   { opacity: 1; }
        94%  { opacity: 1; }
        100% { opacity: 0; }
      }

      .kitpin-shot { animation-timing-function: steps(1, end); }

      .kitpin-callouts { position: relative; }

      .kitpin-callout {
        position: absolute;
        inset-block-start: 50%;
        translate: 0 -50%;
        opacity: 0;
        animation: kitpin-callout-in linear both;
        animation-timeline: --kitpin;
        animation-range: contain var(--from) contain var(--to);
      }

      /* Same reasoning as .kitpin-shot--1: the first callout must be readable
         even if no animation ever runs, so the section is never a phone with
         nothing beside it. */
      .kitpin-callout--1 { opacity: 1; }

      @keyframes kitpin-callout-in {
        0%   { opacity: 0; translate: 1.5rem -50%; }
        18%  { opacity: 1; translate: 0 -50%; }
        82%  { opacity: 1; translate: 0 -50%; }
        100% { opacity: 0; translate: -1rem -50%; }
      }

      /* Arrow pointing back at the device. */
      .kitpin-arrow {
        display: block;
        position: relative;
        flex: none;
        width: clamp(2rem, 5vw, 3.5rem);
        height: 1px;
        margin-block-start: 1.6rem;
        background: var(--green);
      }

      .kitpin-arrow::before {
        content: '';
        position: absolute;
        inset-inline-start: 0;
        top: 50%;
        width: 0.5rem;
        height: 0.5rem;
        border-left: 1px solid var(--green);
        border-bottom: 1px solid var(--green);
        transform: translateY(-50%) rotate(45deg);
      }

      @media (max-width: 599px) {
        .kitpin-stage {
          grid-template-columns: 1fr;
          grid-template-rows: auto auto;
          align-content: start;
          gap: clamp(0.75rem, 1.8svh, 1.05rem);
          padding-block: clamp(0.65rem, 1.7svh, 1rem) clamp(1rem, 2.4svh, 1.35rem);
        }

        /* The desktop mirror is DOM order (callouts first, device second) so
           the 2-column grid places text on the left without an `order`
           override. On a single mobile column that same DOM order put the
           text row ABOVE the phone and left nothing below it — the opposite
           of feature-pin.liquid's mobile layout, and the actual bug Henry
           saw ("no text below"). Forcing the row order here restores
           phone-then-text on mobile for both sections, while leaving the
           desktop mirror above untouched. */
        .kitpin-device {
          order: 1;
          align-self: center;
          perspective: 1000px;
          perspective-origin: 50% 45%;
        }

        /* Smaller than it was, on purpose. The bullets below are the
           substance of each item and they now render on mobile too, so the
           tile gives up the vertical space they need. */
        .kitpin-frame {
          width: min(56vw, 14rem);
          animation-name: kitpin-mobile-turn;
        }

        @keyframes kitpin-mobile-turn {
          0%   { transform: rotateY(14deg)  rotateX(4deg)  translate3d(2%, 3%, 0) scale(0.96); }
          35%  { transform: rotateY(-4deg)  rotateX(-1deg) translate3d(-1%, 2%, 0) scale(1); }
          70%  { transform: rotateY(-12deg) rotateX(3deg)  translate3d(1%, 2%, 0) scale(0.98); }
          100% { transform: rotateY(3deg)   rotateX(-3deg) translate3d(-1%, 2%, 0) scale(1); }
        }

        .kitpin-callouts {
          order: 2;
          align-self: start;
          /* Callouts are absolutely positioned, so their height never pushes
             this container — min-height has to clear the tallest item or the
             bullets get silently clipped. */
          min-height: 12.6rem;
          width: 100%;
        }

        .kitpin-callout {
          inset: 0 0 auto;
          display: block;
          translate: 0 0;
          animation-name: kitpin-mobile-callout-in;
        }

        @keyframes kitpin-mobile-callout-in {
          0%   { opacity: 0; translate: 0 0.65rem; }
          18%  { opacity: 1; translate: 0 0; }
          82%  { opacity: 1; translate: 0 0; }
          100% { opacity: 0; translate: 0 -0.55rem; }
        }

        .kitpin-callout figcaption {
          max-width: 24rem;
          margin-inline: auto;
          gap: 0.22rem;
        }

        .kitpin-arrow { display: none; }

        .kitpin-step {
          font-size: 0.64rem;
          letter-spacing: 0.16em;
        }

        .kitpin-feature {
          font-size: 1.85rem;
          line-height: 0.94;
          margin-block: 0.05rem 0.25rem;
        }

        .kitpin-caption {
          display: block;
          font-size: 0.88rem;
          line-height: 1.35;
          max-width: 100%;
        }

        /* Henry asked for the desktop bullet list on mobile too. It was
           hidden purely to save vertical space; the space now comes out of
           the tile instead, which is the right trade — the bullets are the
           only place the page says what each item actually solves. */
        .kitpin-points {
          display: grid;
          font-size: 0.72rem;
          gap: 0.2rem;
          margin-block-start: 0.4rem;
        }

        .kitpin-points li {
          font-size: 0.72rem;
          line-height: 1.35;
          padding-inline-start: 0.9rem;
        }
      }

      @media (max-width: 599px) and (max-height: 720px) {
        .kitpin-stage {
          gap: 0.55rem;
          padding-block: 0.35rem 0.65rem;
        }

        /* Shrunk from 58vw so the caption below has room without the device
           and text together overflowing a short screen. */
        .kitpin-frame {
          width: min(44vw, 10rem);
        }

        .kitpin-callouts {
          min-height: 10.3rem;
        }

        .kitpin-step {
          font-size: 0.58rem;
        }

        .kitpin-feature {
          font-size: 1.3rem;
          margin-block: 0.05rem 0.2rem;
        }

        /* Henry asked for this back — it was hidden entirely to fit short
           screens, and the fix was to shrink and clamp it, not remove it. */
        .kitpin-caption {
          display: -webkit-box;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 1;
          overflow: hidden;
          font-size: 0.72rem;
          line-height: 1.3;
        }

        .kitpin-points,
        .kitpin-points li {
          font-size: 0.64rem;
        }

        .kitpin-points {
          gap: 0.12rem;
          margin-block-start: 0.3rem;
        }
      }
    }
  }

  /* Phones get the same pinned sequence as desktop when scroll timelines are
     available. Unsupported browsers and reduced-motion users still get the
     complete stacked layout above. */
{% endstylesheet %}

{% schema %}
{
  "name": "Kit contents (pinned)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "The kit" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Four things. One job each." },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>A$99, one time. Everything you need to record hands-free, nothing you don't.</p>"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        { "value": "light", "label": "Base" },
        { "value": "dark", "label": "Raised" }
      ],
      "default": "light"
    },
    {
      "type": "paragraph",
      "content": "Mirrors feature-pin.liquid directly above it — same pinned-scroll engine, opposite layout (text left, device right). Pins to the viewport and turns through each item as you scroll; degrades to a plain vertical list without scroll-timeline support or under reduced motion."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "asset_name", "label": "Theme asset filename", "info": "e.g. clippar-kit-mount-render.jpg. Leave blank to show a numbered placeholder — do not use a stock photo of a different supplier's product." },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "feature", "label": "Item name", "default": "Item" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "What this item does." },
        {
          "type": "textarea",
          "id": "points",
          "label": "What it solves",
          "info": "One per line."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Kit contents (pinned)",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "asset_name": "clippar-kit-mount-photo.jpg",
            "feature": "The mount",
            "caption": "Clamps to your bag or buggy and stays there for the round.",
            "points": "Grips a bag frame, buggy handle or cart rail\nFits any phone, with or without a case\nAdjustable angle, wraps on tight\nLeave it clipped on \u2014 no pulling your phone out to score"
          }
        },
        {
          "type": "item",
          "settings": {
            "asset_name": "clippar-kit-clicker.jpg",
            "feature": "The clicker",
            "caption": "One click starts recording. Click again to stop.",
            "points": "Start and stop recording without touching your phone\nDouble-click to move to the next hole\nTriple-click flags a penalty stroke\nUSB-C rechargeable, not a coin cell \u2014 20m range"
          }
        },
        {
          "type": "item",
          "settings": {
            "asset_name": "clippar-kit-badge-reel.jpg",
            "feature": "The badge reel",
            "caption": "Clips the clicker to your belt loop.",
            "points": "Keeps the clicker within reach on every shot\nStops it getting lost in a bag pocket"
          }
        },
        {
          "type": "item",
          "settings": {
            "asset_name": "clippar-kit-power-bank.jpg",
            "feature": "The power bank",
            "caption": "A 5,000mAh top-up for your phone, mid-round.",
            "points": "Attaches directly to your phone\nSlim enough for a bag pocket\nWorks as an everyday power bank off the course, too"
          }
        }
      ]
    }
  ]
}
{% endschema %}
